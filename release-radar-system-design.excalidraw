    {
      "id": "el64",
      "type": "text",
      "x": 948,
      "y": 1109,
      "width": 404,
      "height": 455.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
