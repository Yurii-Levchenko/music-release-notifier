# Rendered at container start by entrypoint.sh. ${ALERT_BOT_TOKEN} and
# ${ALERT_CHAT_ID} come from .env; the rendered copy lands in /tmp, so neither
# the credential nor a personal Telegram id is ever written into this repo.
#
# The alert bot is deliberately a SECOND bot, not the one users talk to. If the
# main token is revoked, rate limited or simply wrong, that is exactly the
# incident worth hearing about — and it cannot be reported through the thing
# that is broken.

route:
  receiver: telegram
  # Grouped by name and severity, not by instance. There is one instance, so
  # grouping by it would put every alert in its own message and undo the
  # batching entirely.
  group_by: [alertname, severity]
  group_wait: 30s
  group_interval: 5m
  # 12h, against the 4h default. One operator who has already read the message
  # does not need it four times a day, and a repeat that frequent trains you to
  # swipe it away — which is how the real one gets missed.
  repeat_interval: 12h
  routes:
    # Critical means delivery has stopped or somebody's subscriptions are being
    # deleted. No batching delay, and a repeat frequent enough to stay
    # uncomfortable until it is dealt with.
    - matchers: ['severity="critical"']
      receiver: telegram
      group_wait: 0s
      repeat_interval: 1h

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: ${ALERT_BOT_TOKEN}
        chat_id: ${ALERT_CHAT_ID}
        # Recovery is information too: without it the only way to learn an
        # alert cleared is that it stopped repeating, which is indistinguishable
        # from alerting having broken.
        send_resolved: true
        # No parse mode, on purpose. HTML and MarkdownV2 both mean a message can
        # fail to send because of a character inside alert text — Telegram
        # answers 400 "can't parse entities" and the notification is simply
        # dropped, which SPEC §10 classifies as our bug rather than something to
        # retry. Every other message in this project can afford that risk for
        # the formatting. This one cannot: it is the message that reports that
        # messages are not arriving.
        parse_mode: ''
        # Two things here were wrong in the first version, and only showed up
        # once real messages arrived on a phone.
        #
        # A resolved alert used to repeat the firing text verbatim, so
        # "RESOLVED" was followed by "delivery is failing, check the bot token"
        # in the present tense. Annotations are written about a problem, and
        # replaying them after it ends says the opposite of what happened. The
        # resolved branch now reports only what recovered and when.
        #
        # And every message carries the alert's own start time, because
        # Telegram's timestamp is the delivery time and the two are not the
        # same. Measured on the first real alert: AlertDeliveryFailing began at
        # 15:38 and was delivered at 16:19, 41 minutes later — since it fires
        # precisely when alerting is broken, the gap is largest exactly when the
        # timestamp matters most.
        #
        # Both zones, because the two readers of this line want different
        # things. UTC is what every log line you would cross-check against is
        # written in, so an alert in local time alone would disagree with
        # everything you read next. Local time is what the phone in your hand
        # says, and subtracting an offset at 3am is exactly when arithmetic goes
        # wrong.
        #
        # The local zone comes from TZ on the container (Europe/Warsaw by
        # default) rather than a fixed offset, so the switch in late October
        # happens on its own and the abbreviation stays truthful — CEST now,
        # CET then. A hardcoded "+2" would be correct today and silently wrong
        # for five months of the year.
        #
        # An unrecognised TZ falls back to UTC, and the line then reads
        # "15:38 UTC (15:38 UTC)" — redundant, but it never claims a local time
        # it did not compute. Verified, because a silent fallback that invented
        # a plausible-looking wrong hour would be far worse than an ugly one.
        #
        # The date is repeated rather than printed once. It looks redundant, and
        # it is, except between 22:00 and midnight UTC when the two zones are on
        # different days — verified: 23:30 UTC Tue 15 Sep renders as 01:30 Wed
        # 16 Sep local. That is the case where a single shared date would be
        # wrong for one of the two times.
        message: |-
          {{ if eq .Status "firing" }}FIRING{{ else }}RESOLVED{{ end }} — {{ .Alerts | len }} alert(s)
          {{ range .Alerts }}
          {{- if eq .Status "firing" }}
          [{{ .Labels.severity }}] {{ .Labels.alertname }}
          {{ .Annotations.summary }}
          {{- with .Annotations.description }}
          {{ . }}
          {{- end }}
          firing since {{ .StartsAt.UTC.Format "15:04 UTC, Mon 2 Jan" }} ({{ .StartsAt.Local.Format "15:04 MST, Mon 2 Jan" }})
          {{- else }}
          {{ .Labels.alertname }} recovered
          was firing {{ .StartsAt.UTC.Format "15:04" }} → {{ .EndsAt.UTC.Format "15:04 UTC, Mon 2 Jan" }} ({{ .StartsAt.Local.Format "15:04" }} → {{ .EndsAt.Local.Format "15:04 MST, Mon 2 Jan" }})
          {{- end }}
          {{ end }}
