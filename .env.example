# Copy to .env and fill in. .env is gitignored.

# Postgres (compose sets these for the db service too)
POSTGRES_USER=releaseradar
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=releaseradar
# Host port 5433 - 5432 is taken by the native PostgreSQL service on this machine.
DATABASE_URL=postgres://releaseradar:change-me-locally@localhost:5433/releaseradar?sslmode=disable
TEST_DATABASE_URL=postgres://releaseradar:change-me-locally@localhost:5433/releaseradar?sslmode=disable

# HTTP
HTTP_ADDR=:8080

# Telegram — not needed until S1
TELEGRAM_BOT_TOKEN=

# Sent to MusicBrainz / ListenBrainz. A UA with a contact address is REQUIRED:
# without one MusicBrainz answers 403, and with a generic one it answers 503.
# QUOTED on purpose - the parentheses break `source .env` in a POSIX shell.
USER_AGENT="ReleaseRadar/0.1 ( your-email@example.com )"

LOG_LEVEL=info

# External dead-man's switch (SPEC S6.1). Create a check at healthchecks.io,
# set the period to 5m and the grace to 10m, then paste its ping URL here.
#
# The process pings this ONLY while every worker is inside its health budget,
# so silence is the alarm: a crash, a wedged worker or an unreachable database
# all stop the pings. Leave it empty and nothing outside the process will
# notice if it dies — which is exactly what happened for 14 hours on
# 29.08.2026.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL=5m

# Alert delivery (SPEC S6.4). Prometheus evaluates the rules in
# deploy/prometheus/alerts.yml; Alertmanager sends what fires to this chat.
#
# This is a SECOND bot, created with @BotFather, and that is the whole point: an
# alert saying the main bot is blocked, throttled or holding a revoked token
# cannot be delivered by the main bot.
#
# Put the token here, send the bot one message in Telegram, then run
# `make alert-chat-id` for the chat id. Do not open
# api.telegram.org/bot<TOKEN>/getUpdates in a browser to get it: that is a live
# credential in the address bar, and from there in history and in sync.
#
# The alertmanager container refuses to start while either of these is empty.
# That is deliberate: it has exactly one job, and an instance that runs without
# a way to reach anybody looks healthy on every dashboard while delivering
# nothing. The rest of the observability stack starts regardless.
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=

# Local zone shown next to UTC in alert messages. An IANA zone name, not an
# offset: "Europe/Warsaw" keeps printing the right time and the right
# abbreviation across the October and March switches, where a hardcoded +2 would
# be correct today and quietly an hour out for five months of the year.
# Affects the alertmanager container only — logs and every other timestamp stay
# UTC, which is what makes an alert and a log line comparable.
ALERT_TZ=Europe/Warsaw

# Database backups. The dumps land in ./backups (gitignored) as a bind mount
# rather than a named volume, so `docker compose down -v` cannot take them and
# you can copy them somewhere that is not this machine — which is the only thing
# that makes them a backup rather than a second copy on the same disk.
#
# Every dump is verified by decoding the whole archive before it is renamed into
# place, so a file in that directory is one that restored cleanly at least once.
# Rotation runs only after a successful dump: a job that has been failing for a
# week must not be the thing that deletes the last good backup.
BACKUP_KEEP=7
BACKUP_INTERVAL_SECONDS=86400
# A failed dump is retried after this, doubling up to an hour. Not the interval:
# a machine that reboots daily would otherwise never reach the next attempt.
BACKUP_RETRY_SECONDS=300
