# Copy to .env and fill in. .env is gitignored.

# Postgres (compose sets these for the db service too)
POSTGRES_USER=releaseradar
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=releaseradar
# Host port 5433 - 5432 is taken by the native PostgreSQL service on this machine.
DATABASE_URL=postgres://releaseradar:change-me-locally@localhost:5433/releaseradar?sslmode=disable
TEST_DATABASE_URL=postgres://releaseradar:change-me-locally@localhost:5433/releaseradar?sslmode=disable

# HTTP
HTTP_ADDR=:8080

# Telegram — not needed until S1
TELEGRAM_BOT_TOKEN=

# Sent to MusicBrainz / ListenBrainz. A UA with a contact address is REQUIRED:
# without one MusicBrainz answers 403, and with a generic one it answers 503.
# QUOTED on purpose - the parentheses break `source .env` in a POSIX shell.
USER_AGENT="ReleaseRadar/0.1 ( your-email@example.com )"

LOG_LEVEL=info

# External dead-man's switch (SPEC S6.1). Create a check at healthchecks.io,
# set the period to 5m and the grace to 10m, then paste its ping URL here.
#
# The process pings this ONLY while every worker is inside its health budget,
# so silence is the alarm: a crash, a wedged worker or an unreachable database
# all stop the pings. Leave it empty and nothing outside the process will
# notice if it dies — which is exactly what happened for 14 hours on
# 29.08.2026.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL=5m
